# ==============================================================================
# CUG 多模态健康与情绪智能检测系统 - 环境变量配置示例
# 复制此文件为 .env 并根据实际部署环境填写相应参数
# ==============================================================================

# 1. 认证安全与系统存储
EMOTION_JWT_SECRET=replace-with-a-long-random-secret
EMOTION_TOKEN_TTL_SECONDS=43200
EMOTION_DATA_DIR=./data
EMOTION_DATABASE_PATH=./data/emotion_management.db
EMOTION_UPLOAD_DIR=./data/uploads

# 2. 大语言模型配置（默认接入本地 llama-server，无需填 key 即可使用）
# 本地模型配置 (Ternary-Bonsai-2-27B on llama-server)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1919/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=Ternary-Bonsai-2-27B-PQ2_0

# 若切换为云端模型（如 SiliconFlow），可配置：
# SILICONFLOW_API_KEY=replace-with-your-api-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# 3. 硬件传感器与音视频采集（支持 serial 串口 或 wifi 网络模式）
# 模式选择: serial (默认物理串口) 或 wifi (ESP32 无线 TCP+UDP)
EMOTION_TRANSPORT_MODE=serial

# 3.1 串口模式参数 (当 EMOTION_TRANSPORT_MODE=serial 时生效)
EMOTION_SERIAL_PORT=COM3
EMOTION_SERIAL_BAUDRATE=2000000

# 3.2 WiFi 无线模式参数 (当 EMOTION_TRANSPORT_MODE=wifi 时生效，设备 IP 以路由器分配为准)
EMOTION_WIFI_HOST=192.168.8.11
EMOTION_WIFI_TCP_PORT=8888
EMOTION_WIFI_UDP_PORT=8889

# 3.3 单片机音频本地回放（可选，1 开启）
# ENABLE_MCU_AUDIO_PLAYBACK=1

# 4. 扩展模型权重路径（可选；当前仓库未附带该 .h5，血压分支会自动降级）
# BP_MODEL_PATH=./detection_models/resnet_ppg_nonmixed.h5
